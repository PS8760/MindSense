# MindSense feature flags and environment
# Copy to .env and adjust. The Streamlit app reads these via os.environ.

# Face mood-cue module (Exp 3). Requires onnxruntime + model artifact.
ENABLE_FACE=1

# DistilBERT text path (Exp 7 comparison). Heavy; off by default.
ENABLE_TRANSFORMER=0

# Default helpline region for the sidebar selector
DEFAULT_REGION=India

# local | ci | production
APP_ENV=local

# Set to 1 to force synthetic-data banners louder in CI smoke runs
FORCE_SYNTHETIC_BANNER=0
