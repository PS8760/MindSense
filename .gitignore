# Data (never commit raw datasets or derived tables — licences prohibit
# redistribution for Drugs.com/Kaggle mirrors; `make data` regenerates them)
data/raw/
data/interim/
data/processed/
*.zip
*.csv.gz

# Large artifacts
*.onnx
*.pt
*.pth
*.h5
!models/**/metadata.json

# Trained model binaries (keep metadata + small artifacts)
models/**/model.joblib
models/**/model.pkl
models/**/model.xgb
models/**/model.bst
models/**/*_vectorizer.joblib
models/**/preprocessor.joblib
models/**/*.onnx
# The deployed mood-cue ONNX (8.5 MB, < 10 MB LFS threshold) ships in the image
# so a fresh clone can build Docker; torch checkpoints above stay ignored.
!models/face_emotion.onnx

# Reports binary outputs stay except curated ones
# (figures/metrics/tables are committed for the report)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg
dist/
build/

# Env / secrets
.env
.kaggle/
kaggle.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Streamlit
.streamlit/secrets.toml
